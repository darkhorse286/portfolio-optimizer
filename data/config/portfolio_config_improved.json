{
  "project": {
    "name": "Portfolio Optimizer",
    "version": "1.0.0",
    "description": "Quantum-ready portfolio optimization with mean-variance and QUBO formulations"
  },

  "data": {
    "start_date": "",
    "end_date": "",
    "universe": [
      "AAPL",
      "MSFT",
      "JPM",
      "JNJ",
      "XOM",
      "WMT",
      "GOOGL",
      "BAC",
      "PFE",
      "CVX"
    ],
    "benchmark": "SPY",
    "data_file": "../market/historical_prices.csv",
    "frequency": "daily"
  },

  "optimizer": {
    "type": "mean_variance",
    "objective": "max_sharpe",
    "risk_aversion": 1.0,
    "constraints": {
      "max_weight": 0.30,
      "min_weight": 0.05,
      "sum_to_one": true,
      "long_only": true,
      "max_turnover": 0.50
    },
    "risk_free_rate": 0.02
  },

  "qubo": {
    "enabled": true,
    "num_bits_per_asset": 4,
    "penalty_constraint": 100.0,
    "penalty_turnover": 50.0,
    "solver": "simulated_annealing",
    "solver_params": {
      "max_iterations": 10000,
      "initial_temperature": 1.0,
      "cooling_rate": 0.99,
      "random_seed": 42
    }
  },

  "ibm_quantum": {
    "enabled": false,
    "backend": "ibm_fez",
    "shots": 1024,
    "qaoa_depth": 1,
    "timeout_minutes": 30,
    "poll_interval_seconds": 30,
    "error_mitigation": false,
    "instance": "",
    "qamo": {
      "max_mf_iterations": 50,
      "mf_convergence_tol": 1e-6
    },
    "qamoo": {
      "n_frontier_points": 20,
      "lambda_min": 0.1,
      "lambda_max": 20.0
    }
  },

  "quantum_solvers": [
    {
      "name": "QAOA Uninformed (Aer)",
      "type": "quantum",
      "backend": "aer_simulator",
      "algorithm_mode": "qaoa",
      "augment_problem_data": false,
      "optimization_level": 3,
      "qaoa_depth": 1,
      "shots": 1024,
      "problem_file": "quantum_problem_qaoa.json",
      "jobs_file": "quantum_jobs_qaoa.json"
    },
    {
      "name": "QAOA Informed (Aer)",
      "type": "quantum",
      "backend": "aer_simulator",
      "algorithm_mode": "qaoa",
      "augment_problem_data": true,
      "optimization_level": 3,
      "qaoa_depth": 1,
      "shots": 1024,
      "problem_file": "quantum_problem_qaoa_informed.json",
      "jobs_file": "quantum_jobs_qaoa_informed.json"
    },
    {
      "name": "QAMO Uninformed (Aer)",
      "type": "quantum",
      "backend": "aer_simulator",
      "algorithm_mode": "qamo",
      "augment_problem_data": false,
      "optimization_level": 3,
      "qaoa_depth": 1,
      "shots": 1024,
      "problem_file": "quantum_problem_qamo.json",
      "jobs_file": "quantum_jobs_qamo.json"
    },
    {
      "name": "QAMO Informed (Aer)",
      "type": "quantum",
      "backend": "aer_simulator",
      "algorithm_mode": "qamo",
      "augment_problem_data": true,
      "optimization_level": 3,
      "qaoa_depth": 1,
      "shots": 1024,
      "problem_file": "quantum_problem_qamo_informed.json",
      "jobs_file": "quantum_jobs_qamo_informed.json"
    },
    {
      "name": "QAOA (IBM)",
      "type": "quantum",
      "backend": "ibm_auto",
      "algorithm_mode": "qaoa",
      "augment_problem_data": false,
      "optimization_level": 3,
      "qaoa_depth": 1,
      "shots": 1024,
      "ibm_min_qubits": 20,
      "ibm_backend_selection": "shortest_queue",
      "problem_file": "quantum_problem_qaoa_ibm.json",
      "jobs_file": "quantum_jobs_qaoa_ibm.json"
    },
    {
      "name": "QAMO (IBM)",
      "type": "quantum",
      "backend": "ibm_auto",
      "algorithm_mode": "qamo",
      "augment_problem_data": true,
      "optimization_level": 3,
      "qaoa_depth": 1,
      "shots": 1024,
      "ibm_min_qubits": 20,
      "ibm_backend_selection": "shortest_queue",
      "problem_file": "quantum_problem_qamo_ibm.json",
      "jobs_file": "quantum_jobs_qamo_ibm.json"
    },
    {
      "name": "QAMOO (Aer)",
      "type": "quantum",
      "backend": "aer_simulator",
      "algorithm_mode": "qamoo",
      "augment_problem_data": true,
      "optimization_level": 3,
      "qaoa_depth": 1,
      "shots": 1024,
      "n_frontier_points": 20,
      "timeout_seconds": 600,
      "problem_file": "quantum_problem_qamoo_aer.json",
      "jobs_file": "quantum_jobs_qamoo_aer.json"
    }
  ],

  "risk_model": {
    "type": "ewma",
    "estimation_window": 252,
    "ewma_lambda": 0.94
  },

  "backtest": {
    "initial_capital": 1000000.0,
    "rebalance_frequency": "monthly",
    "lookback_window": 252,
    "min_history": 60,
    "transaction_costs": {
      "commission_rate": 0.001,
      "slippage_bps": 5.0,
      "market_impact": "linear"
    },
    "cash_management": {
      "allow_cash": true,
      "cash_return": 0.0
    }
  },

  "performance": {
    "metrics": [
      "total_return",
      "annualized_return",
      "volatility",
      "sharpe_ratio",
      "max_drawdown",
      "sortino_ratio",
      "calmar_ratio",
      "win_rate",
      "profit_factor",
      "alpha",
      "beta",
      "information_ratio",
      "tracking_error"
    ],
    "benchmark_comparison": true,
    "rolling_window": 252,
    "confidence_level": 0.95
  },

  "output": {
    "results_dir": "results",
    "plots": {
      "enabled": true,
      "format": "png",
      "dpi": 300,
      "size": {
        "width": 12,
        "height": 8
      }
    },
    "reports": {
      "enabled": true,
      "format": "markdown",
      "include_charts": true
    }
  }
}